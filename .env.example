# ---------------------------------------------------------------------------
# backend/.env   (copy this file there; never commit the real one)
# ---------------------------------------------------------------------------

# Database. Local Docker default shown. For Supabase use the "Session pooler" connection string
# (Project Settings -> Database -> Connection string -> Session pooler).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/support

GEMINI_API_KEY=

# Admin login (Supabase Auth). If any of these three is empty, the admin API is disabled.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
ADMIN_EMAILS=you@example.com

# Optional overrides
# PRODUCT_NAME=InvoiceFlow
# GEN_MODEL=gemini-3.5-flash-lite
# EMBED_MODEL=gemini-embedding-001
# MIN_SIMILARITY=0.5
# CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# frontend/.env.local   (a separate file; only PUBLIC values go here)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# NEVER put the Supabase service-role key or the database password in the frontend, and this
# project does not need the service-role key at all.
