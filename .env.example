# ---------------------------------------------------------------------------
# backend/.env   (copy this file there; never commit the real one)
# ---------------------------------------------------------------------------

# Database. Local Docker default shown. For Supabase use the "Session pooler" connection string
# (Project Settings -> Database -> Connection string -> Session pooler).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/support

GEMINI_API_KEY=

# Admin login (Supabase Auth). If any of these three is empty, the admin API is disabled.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
ADMIN_EMAILS=you@example.com

# Optional overrides
# PRODUCT_NAME=InvoiceFlow
# GEN_MODEL=gemini-3.5-flash-lite
# EMBED_MODEL=gemini-embedding-001
# MIN_SIMILARITY=0.5
# CORS_ORIGINS=http://localhost:3000
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_PER_CLIENT_PER_DAY=150
# RATE_LIMIT_GLOBAL_PER_DAY=500
# TRUSTED_PROXY_HOPS=0     (0 locally; on a host with one proxy in front, see the README's deployment section)
#
# Hybrid search (vector + keyword). Off by default: it did not help on the demo corpus (see README).
# HYBRID_SEARCH=false

# ---------------------------------------------------------------------------
# frontend/.env.local   (a separate file; only PUBLIC values go here)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SITE_URL=https://your-site.example   (used for link previews; set once deployed)
#
# NEVER put the Supabase service-role key or the database password in the frontend, and this
# project does not need the service-role key at all.
